</span></span><span style="display:flex;"><span>            <span style="color:#66d9ef">return</span> res
</span></span><span style="display:flex;"><span>        nodes <span style="color:#f92672">=</span> [
</span></span><span style="display:flex;"><span>            root,
</span></span><span style="display:flex;"><span>        ]
</span></span><span style="display:flex;"><span>        <span style="color:#66d9ef">while</span> len(nodes) <span style="color:#f92672">&gt;</span> <span style="color:#ae81ff">0</span>:
</span></span><span style="display:flex;"><span>            tiers, nodes <span style="color:#f92672">=</span> fetch(nodes)
</span></span><span style="display:flex;"><span>            res<span style="color:#f92672">.</span>append(tiers)
</span></span><span style="display:flex;"><span>        <span style="color:#66d9ef">return</span> res
</span></span></code></pre></div>
